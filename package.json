{
  "name": "trading-next-python",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/kill-dev.mjs && concurrently --kill-others \"npm run dev:next\" \"npm run dev:backend\"",
    "dev:next": "next dev",
    "dev:backend": "cd backend && ../.venv/Scripts/python.exe -m uvicorn app:app --host 127.0.0.1 --port 5000",
    "kill": "node scripts/kill-dev.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@types/react-beautiful-dnd": "^13.1.8",
    "chart.js": "^4.4.2",
    "concurrently": "^9.1.0",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.468.0",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-beautiful-dnd": "^13.1.1",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "19.2.3",
    "react-toastify": "^10.0.6",
    "recharts": "^2.13.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^2.1.8"
  }
}
